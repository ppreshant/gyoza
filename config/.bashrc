# Aliases to my directories (for navigation)
alias home='cd /home/$USER'
alias projects='cd /projects/$USER'
alias scratch='cd /scratch/alpine/$USER'

# Aliases for moving to these directories
# Usage: mvhome <from_dir>
alias mvhome='mv -t /home/$USER'
alias mvprojects='mv -t /projects/$USER'
alias mvscratch='mv -t /scratch/alpine/$USER'